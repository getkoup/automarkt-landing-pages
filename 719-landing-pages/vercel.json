{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "trailingSlash": true,
  "routes": [
    {
      "src": "/(?:cc|tint|ppf)/thank-you\\.html",
      "headers": {
        "Location": "/thank-you.html"
      },
      "status": 307
    },
    {
      "src": "/ceramic(?:/.*)?",
      "status": 404
    }
  ]
}
